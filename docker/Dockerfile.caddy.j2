# syntax=mirror.gcr.io/docker/dockerfile:1.24
# vim: ft=dockerfile

# Upstream Caddy, rebuilt and signed by this repository's pipeline so
# that bin/verify_image_signatures.sh covers the one container that
# faces the network on every install. Nothing is added to the binary.
FROM {{ caddy_base_image }}

ENV GIT_HASH={{ git_hash }}
ENV GIT_SHORT_HASH={{ git_short_hash }}
ENV GIT_BRANCH={{ git_branch }}

{% include 'labels.j2' %}

# The bootstrap config only proxies :80 to anthias-server and opens the
# admin API on a Unix socket in the shared anthias-caddy-run volume.
# anthias-server replaces it with the real config (HTTPS, certificates)
# over that socket as soon as it starts. --resume makes a restarted
# Caddy come back with the last config that loaded successfully
# (autosaved under /config), so a Caddy restart never drops HTTPS while
# anthias-server is down.
COPY docker/caddy/bootstrap.json /etc/anthias/caddy-bootstrap.json

CMD ["caddy", "run", "--config", "/etc/anthias/caddy-bootstrap.json", "--resume"]
