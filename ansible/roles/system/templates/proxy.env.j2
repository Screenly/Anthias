# Managed by Anthias — HTTP proxy support (GH #3239). Do not edit by hand;
# regenerated from ansible on every install/upgrade.
#
# Single source of truth for the proxy, consumed by:
#   - the Docker daemon systemd drop-in (docker.service.d/http-proxy.conf)
#   - the anthias-host-agent systemd unit (EnvironmentFile)
#   - bin/upgrade_containers.sh, which sources this (set -a) so the values
#     are rendered into the server/viewer/celery container environment.
#
# Format is plain KEY=VALUE (no `export`, no quotes) so it is valid both as
# a systemd EnvironmentFile and for `set -a; . this_file`. Both upper- and
# lower-case names are emitted because different tools read different ones.
HTTP_PROXY={{ anthias_http_proxy }}
HTTPS_PROXY={{ anthias_https_proxy }}
NO_PROXY={{ anthias_no_proxy_effective }}
http_proxy={{ anthias_http_proxy }}
https_proxy={{ anthias_https_proxy }}
no_proxy={{ anthias_no_proxy_effective }}
