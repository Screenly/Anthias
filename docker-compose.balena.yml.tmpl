# vim: ft=yaml

version: "2"
services:
  anthias-server:
    image: ghcr.io/screenly/anthias-server:${GIT_SHORT_HASH}-${BOARD}
    ports:
      - 80:8080
    environment:
      - HOME=/data
      - LISTEN=0.0.0.0
      - CELERY_BROKER_URL=redis://redis:6379/0
      - CELERY_RESULT_BACKEND=redis://redis:6379/0
    depends_on:
      - redis
    # No `devices:` here, and none needed. HDMI-CEC is driven by the
    # anthias-viewer container, which is privileged and therefore
    # already sees every /dev/cec* node; this service asks it over the
    # Redis command bus (src/anthias_server/lib/cec_client.py).
    #
    # That indirection is what makes CEC work on balena at all. The
    # compose file here is baked into the release from a workstation,
    # nothing on-device can enumerate the host's adapters, and a
    # statically listed node that turns out to be absent would stop the
    # container from starting. /dev/vchiq used to be listed for libcec,
    # which is gone.
    restart: always
    volumes:
      - resin-data:/data
    labels:
      io.balena.features.supervisor-api: '1'

  anthias-viewer:
    image: ghcr.io/screenly/anthias-viewer:${GIT_SHORT_HASH}-${BOARD}
    depends_on:
      - anthias-server
    # Issue #480 — to localise URL-asset rendering, set LANG (and
    # optionally LANGUAGE) as a balena Device or Service Variable in the
    # dashboard, e.g. LANG=nl_NL.UTF-8. balena's supervisor injects
    # dashboard variables as env vars into the running container at
    # boot, so no entry is needed in this `environment:` block —
    # AnthiasWebview reads QLocale::system() and builds Accept-Language
    # from whatever LANG/LANGUAGE the supervisor passed in.
    environment:
      - HOME=/data
      - PORT=8080
      - NOREFRESH=1
      - LISTEN=anthias-server
      # Lets start_viewer.sh reach the host systemd over the host system
      # bus (mounted by io.balena.features.dbus below) to quit the
      # Plymouth boot splash before launching the display. balenaOS
      # leaves Plymouth running and on x86 it holds DRM master, which
      # blocks cage. See release_boot_splash() in bin/start_viewer.sh.
      - DBUS_SYSTEM_BUS_ADDRESS=unix:path=/host/run/dbus/system_bus_socket
    privileged: true
    restart: always
    shm_size: ${SHM_SIZE}
    volumes:
      - resin-data:/data
    labels:
      io.balena.features.supervisor-api: '1'
      io.balena.features.dbus: '1'

  anthias-celery:
    # Runs on the same image as anthias-server with a CMD override.
    # See docker-compose.yml.tmpl for context on the merge.
    image: ghcr.io/screenly/anthias-server:${GIT_SHORT_HASH}-${BOARD}
    command: >
      nice -n 19 ionice -c 3
      celery -A anthias_server.celery_tasks.celery worker -B -n worker@anthias
      --loglevel=info --schedule /tmp/celerybeat-schedule
    depends_on:
      - anthias-server
      - redis
    environment:
      - HOME=/data
      - CELERY_BROKER_URL=redis://redis:6379/0
      - CELERY_RESULT_BACKEND=redis://redis:6379/0
    # No `devices:` here, and none needed. HDMI-CEC is driven by the
    # anthias-viewer container, which is privileged and therefore
    # already sees every /dev/cec* node; this service asks it over the
    # Redis command bus (src/anthias_server/lib/cec_client.py).
    #
    # That indirection is what makes CEC work on balena at all. The
    # compose file here is baked into the release from a workstation,
    # nothing on-device can enumerate the host's adapters, and a
    # statically listed node that turns out to be absent would stop the
    # container from starting. /dev/vchiq used to be listed for libcec,
    # which is gone.
    restart: always
    volumes:
      - resin-data:/data
    labels:
      io.balena.features.supervisor-api: '1'

  # The WiFi setup portal. Started by the supervisor on every boot and
  # every release apply, which is safe because the DAEMON decides whether
  # a portal is needed -- there is no systemd here to hang an
  # ExecCondition on, and nothing in a compose file can gate a service.
  #
  # wifi-connect 2026.10.11 is the release that makes that true: before
  # it, a device online over ethernet alone was not considered online
  # (NetworkManager reports connectivity as "unknown" wherever the check
  # is unavailable, and only an associated radio counted), so every start
  # raised an access point at a perfectly healthy screen. Verified on a
  # wired Pi 5 and Pi 3 B+ against 2026.10.11: exits 0 in ~20 seconds
  # with "already online; the portal is not needed", no access point, no
  # state file. The same test against 2026.10.10 raises one.
  #
  # Do NOT pin this below 2026.10.11.
  anthias-wifi-connect:
    image: ghcr.io/screenly-labs/wifi-connect:2026.10.11
    # Serving DHCP, which does not survive Docker's NAT, and binding the
    # access point's own address on the wireless device.
    network_mode: host
    # Exits 0 as soon as the device is online, which on a healthy screen
    # is the first thing it does. `always` would both churn a container
    # start a minute forever and, on a device whose connectivity cannot
    # be determined, re-raise the access point every ACTIVITY_TIMEOUT.
    restart: "no"
    environment:
      # NetworkManager lives on the host; io.balena.features.dbus below
      # is what puts its socket in this container.
      - DBUS_SYSTEM_BUS_ADDRESS=unix:path=/host/run/dbus/system_bus_socket
      # A PREFIX: the portal appends four random characters, so five
      # screens in one room do not all broadcast one name.
      - PORTAL_SSID=Anthias Setup
      - WIFI_CONNECT_BRAND_NAME=Anthias
      - WIFI_CONNECT_DEFAULT_THEME=dark
      # NOT 80: anthias-server publishes 80:8080 on the host.
      - PORTAL_LISTENING_PORT=8000
      - WIFI_CONNECT_QR_OUTPUT=/data/hotspot
      # How anthias-server learns the SSID, passphrase and portal
      # address to put on the screen, and whether a portal is live.
      - WIFI_CONNECT_STATE_FILE=/data/hotspot/state.json
      - WIFI_CONNECT_NO_QR_STDOUT=true
      # Idle, not a session cap, as of 2026.10.9.
      - ACTIVITY_TIMEOUT=900
    volumes:
      - resin-data:/data
    labels:
      io.balena.features.dbus: '1'

  redis:
    image: ghcr.io/screenly/anthias-redis:${GIT_SHORT_HASH}-${BOARD}
    ports:
      - 127.0.0.1:6379:6379
    restart: always
    volumes:
      - redis-data:/var/lib/redis

volumes:
  resin-data:
  redis-data:
