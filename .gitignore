# Local pytest SQLite database (created by
# src/anthias_server/django_project/settings.py when ENVIRONMENT=test
# and ANTHIAS_TEST_DB_PATH is not set. The
# `-journal` / `-wal` / `-shm` siblings appear in WAL mode.
.anthias-test.db
.anthias-test.db-journal
.anthias-test.db-wal
.anthias-test.db-shm

# Local agent state (Claude Code). Ignore everything under .claude by default —
# git worktrees, unfiltered local memory, caches — but keep the curated,
# PII-scrubbed knowledge base that ships with the repo (so it tracks without a
# forced add). These are still excluded from Docker images by .dockerignore.
.claude/*
!.claude/MEMORY.md
!.claude/skills/

# Git worktrees must never be committed (each is a nested checkout). The
# .claude/* rule above already covers .claude/worktrees/; these keep any common
# worktree folder ignored no matter where the tooling places it.
.claude/worktrees/
/worktrees/
/.worktrees/

# Django
staticfiles/

# Hugo
website/public/
website/resources/
website/.hugo_build.lock

